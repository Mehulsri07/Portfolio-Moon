{
  "ci": {
    "collect": {
      "staticDistDir": "./",
      "url": [
        "http://localhost/index.html",
        "http://localhost/pages/coding.html",
        "http://localhost/pages/stratafield.html",
        "http://localhost/pages/creativity.html",
        "http://localhost/pages/notes-grafana-subpath.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.6 }]
      }
    }
  }
}
